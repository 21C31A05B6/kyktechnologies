# KYK Technologies — environment template.
# Copy this to .env and fill in real values. NEVER commit or zip the real
# .env — it holds live credentials. If a .env with real secrets was ever
# shared (e.g. inside a project ZIP), rotate every value below immediately:
# the database password, SECRET_KEY, and admin/demo passwords.

# ── Database ────────────────────────────────────────────────────────────
# Leave unset to use the zero-config JSON file store under /data (dev only).
# Set to a SQLAlchemy URL to use PostgreSQL in production:
DATABASE_URL=

# ── Auth / tokens ───────────────────────────────────────────────────────
# Long, random, unique per environment. Rotate this and every issued
# token becomes invalid immediately (use that to force-logout everyone).
SECRET_KEY=

# ── Seed / demo accounts (first run only) ──────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_PASSWORD=

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000

# ── Attendance ──────────────────────────────────────────────────────────
# IANA tz name. Business dates and late/early/overtime calculations use
# this timezone, not UTC.
COMPANY_TIMEZONE=Asia/Kolkata
SHIFT_START=09:00
SHIFT_END=18:00
LATE_GRACE_MINUTES=10
EARLY_LEAVE_GRACE_MINUTES=10
# Comma-separated, Python weekday numbers (Mon=0..Sun=6). Default Sat/Sun.
WEEKEND_DAYS=5,6

# ── Rate limiting (recommended once you run more than one Gunicorn worker) ─
# Without this, each worker keeps its own counter and the effective limit
# multiplies by worker count.
REDIS_URL=
